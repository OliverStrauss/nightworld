# Copy to ~/.config/nightworld/board.env on the Pi (install.sh does it), then fill in.
# It lives outside the repo: never commit tokens or the password hash.
# If you're moving from the laptop, copy the laptop's board.env instead and only change the
# paths below, so the runner's tokens keep working.

# Where the board listens. 0.0.0.0 = reachable from your home Wi-Fi (phone, laptop) at
# http://<pi-hostname>.local:8787. Use 127.0.0.1 if you only reach it through `tailscale serve`.
BOARD_HOST=0.0.0.0
BOARD_PORT=8787

# The SQLite database. Back it up with backup.sh.
BOARD_DB=/home/oliver/nightworld-board.db

# Web UI login for oliver: run `.venv/bin/python -m app.auth` in board/, paste the hash.
# No quotes needed here (systemd reads this file, not bash).
BOARD_PASSWORD_HASH=pbkdf2_sha256$change-me
# Signs the login cookie: python3 -c 'import secrets; print(secrets.token_hex(32))'
BOARD_SECRET=change-me

# One API token per actor. The runner's runner.env uses the builder and reviewer ones.
# Make each with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BOARD_TOKEN_OLIVER=change-me
BOARD_TOKEN_BUILDER=change-me
BOARD_TOKEN_REVIEWER=change-me
BOARD_TOKEN_GROOMER=change-me

# "Split into cards" runs the groomer with Claude Code in this clone (read-only).
# Needs `claude` installed and signed in for this user (see runner/README.md).
BOARD_REPO_DIR=/home/oliver/nightworld-board
# BOARD_CLAUDE_CMD=claude
# BOARD_SPLIT_TIMEOUT=900
