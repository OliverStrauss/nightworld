# Copy to ~/.config/nightworld/runner.env on the Pi and fill in.
# It lives outside the repo because the runner's clone is reset and cleaned every night.

# A clone of the repo used ONLY by the runner (it gets reset to origin/main every night).
REPO_DIR=/home/oliver/nightworld-runner

# Task board API (runs on the same Pi).
BOARD_URL=http://localhost:8787

# Per-agent API tokens from the board, so the activity log shows who did what.
BUILDER_TOKEN=change-me
REVIEWER_TOKEN=change-me

LOG_DIR=/home/oliver/nightworld-logs

# Optional limits
# BUILDER_MAX_TURNS=120
# REVIEWER_MAX_TURNS=40
# BUILDER_TIMEOUT=3h
# CI_TIMEOUT=90m

# Claude Code auth for cron (from `claude setup-token`), if not set in your profile
# CLAUDE_CODE_OAUTH_TOKEN=
